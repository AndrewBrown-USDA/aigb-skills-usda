{
  "name": "aigb-skills-usda",
  "version": "0.3.0",
  "description": "Andrew Brown's curated public USDA skills repository with a thin skills CLI.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "main": "src/cli.js",
  "exports": {
    ".": "./src/cli.js"
  },
  "bin": {
    "skills": "bin/skills.js"
  },
  "scripts": {
    "help": "node bin/skills.js --help",
    "smoke": "node scripts/smoke.js",
    "test": "node scripts/smoke.js",
    "test:validate": "node scripts/validate-skills-test.js",
    "test:skills": "node skills/copilot-history-miner/scripts/history_miner_test.js && node skills/copilot-history-miner/scripts/adapters_test.js && node skills/copilot-history-briefing/scripts/briefing_contract_test.js",
    "validate:skills": "node scripts/validate-skills.js",
    "catalog:mine": "node scripts/mine-history.js --output catalog/skills.lock.json",
    "skills:sync": "node scripts/sync-skills.js",
    "skills:install": "node scripts/install.js"
  },
  "engines": {
    "node": ">=18"
  }
}
